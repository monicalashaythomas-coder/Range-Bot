# ============================================================
# DERIV EXPIRYRANGE + NOTOUCH BOT — Railway Variables
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────
DERIV_API_TOKEN=your_token_here
DERIV_APP_ID=your_app_id_here

# ── ACCOUNT ──────────────────────────────────────────────────
# Leave blank to auto-resolve (picks demo by default)
DERIV_ACCOUNT_ID=
DERIV_USE_REAL=false

# ── CONTRACT MODE ─────────────────────────────────────────────
# both | expiryrange | notouch
CONTRACT_MODE=both

# ── RISK ─────────────────────────────────────────────────────
MIN_STAKE=1.00
MAX_STAKE_PCT=0.05
KELLY_FRAC=0.25
STOP_LOSS=20.00
TARGET_PROFIT=0.0
STOP_PCT=0.0
TARGET_PCT=0.0

# ── CIRCUIT BREAKER ───────────────────────────────────────────
CONSEC_LOSS_LIMIT=3
CONSEC_PAUSE_SECS=300

# ── EVALUATION PACING ─────────────────────────────────────────
# Minimum seconds between evaluations per symbol
EVAL_COOLDOWN=30

# ── MC SIMULATIONS ────────────────────────────────────────────
# Reduce if Railway CPU is struggling
ER_SIMS=1000
NT_SIMS=1000
ER_TOP_K=6
NT_TOP_K=6

# ── PERSISTENCE (optional) ────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── VOLATILITY THRESHOLDS ────────────────────────────────────
# Tuned for 1HZ10V and 1HZ100V return-scale sigma.
# 1HZ10V is much lower vol than 1HZ100V — if one symbol
# always hits SKIP, adjust these thresholds.
VOL_LOW=0.000015
VOL_HIGH=0.000120
VOL_SKIP=0.000300
